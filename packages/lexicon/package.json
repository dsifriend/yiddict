  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.29.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/**/*",
    "database/**/*.sql",
    "README.md"
  ],
  "repository": {
    "type": "git",
