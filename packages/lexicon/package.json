{
  "name": "@yiddict/lexicon",
  "version": "1.0.0-alpha.0",
  "description": "OntoLex-compatible interface for encoding lexical data in the Yiddict project.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
