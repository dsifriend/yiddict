{
  "name": "unifier",
  "description": "A collection of scripts for converting lexical data into a unified TEI format.",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm run dev:all",
    "dev:all": "concurrently \"pnpm run dev:refoyl\"",
    "dev:refoyl": "nodemon --exec tsx src/converters/refoyl.ts --watch src/converters/refoyl.ts --watch data/refoyl/new.s",
    "convert": "pnpm run convert:all",
    "convert:all": "pnpm run convert:refoyl",
    "convert:refoyl": "tsx src/converters/refoyl.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "typescript-parsec": "^0.3.4"
  }
}
