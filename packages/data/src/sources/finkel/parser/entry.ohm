FinkelEntry {
  entryLine = delim? sequence delim? trailingComment?
  sequence = component (componentJoin component)*

  component = form
            | macro
            | bracketedData

  componentJoin = delim+
                | macroJoin
  macroJoin = &"/"

  delim = (" " | "\t" | ",")+
  ws = (" " | "\t")+

  form = formChunk+
  formChunk = formBase formSpelling?
  formSpelling = ws* "{" spellingBase "}"
  spellingBase = spellingChar+
  spellingChar = formChar
              | "~"
              | " " // non-breaking space
  formBase = formChar+
  formChar = alnum
           | "_"
           | "'"
           | "|"
           | "#"
           | "-"
           | "″"
           | "ʼ"

  macro = "/" macroSymbolChars macroArgument?
  macroArgument = ws* form
  macroSymbolChars = macroSymbolChar+
  macroSymbolChar = "A" | "B" | "C" | "D" | "E" | "G" | "H" | "I" | "J" | "K" | "L" | "N" | "P" | "S" | "T" | "V" | "X" | "-"

  bracketedData = "[" bracketInner "]"
  bracketInner = (~("]" | "[") any)+

  trailingComment = delim? "%" (~"\n" any)*
}
