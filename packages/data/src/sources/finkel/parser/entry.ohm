FinkelEntry {
  entryLine = delim? sequence delim? trailingComment?
  sequence = component (delim+ component)*

  component = form
            | macro
            | bracketedData

  delim = (" " | "\t" | ",")+
  ws = (" " | "\t")+

  form = formBase formSpelling?
  formSpelling = ws* "{" formBase "}"
  formBase = formChar+
  formChar = alnum
           | "_"
           | "'"
           | "|"
           | "#"
           | "-"
           | "″"
           | "ʼ"

  macro = "/" macroSymbolChars macroArgument?
  macroArgument = ws* form
  macroSymbolChars = macroSymbolChar+
  macroSymbolChar = "A" | "B" | "C" | "D" | "E" | "G" | "H" | "I" | "J" | "K" | "L" | "N" | "P" | "S" | "T" | "V" | "X" | "-"

  bracketedData = "[" bracketInner "]"
  bracketInner = (~("]" | "[") any)+

  trailingComment = delim? "%" (~"\n" any)*
}
